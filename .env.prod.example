# Скопируйте в .env (рядом с docker-compose.prod.yml) на ДОМАШНЕМ сервере:
#   cp .env.prod.example .env
# и отредактируйте значения. Файл .env НЕ коммитьте в git.

POSTGRES_USER=app
POSTGRES_PASSWORD=ПОМЕНЯЙТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ
POSTGRES_DB=china_reviews

# Длинная случайная строка. Сгенерировать: openssl rand -hex 32
SECRET_KEY=ПОМЕНЯЙТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# true — наполнить БД демо-данными при первом старте. Потом можно поставить false.
AUTO_SEED=true
