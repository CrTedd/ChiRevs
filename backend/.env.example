# Скопируйте этот файл в .env и при необходимости измените значения.

# По умолчанию (без .env) используется SQLite — проект работает сразу.
# Для PostgreSQL раскомментируйте строку ниже:
# DATABASE_URL=postgresql+psycopg2://app:app_password@localhost:5432/china_reviews

DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me-to-a-long-random-string
AUTO_SEED=true
